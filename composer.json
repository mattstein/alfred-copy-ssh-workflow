{
  "name": "mattstein/alfred-copy-ssh-workflow",
  "type": "project",
  "description": "Copy a public SSH key to the clipboard.",
  "keywords": [
    "alfred"
  ],
  "require": {
    "php": "^8.2",
    "joetannenbaum/alfred-workflow": "dev-master"
  },
  "require-dev": {
    "pestphp/pest": "^3.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/mattstein/alfred-workflow"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "MattStein\\CopySsh\\": "src/"
    }
  }
}
